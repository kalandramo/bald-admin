server:
  http: { addr: ":8080" }
  grpc:  { addr: ":9090" }
gateway: { addr: ":8081" }
log: { level: "info", format: "json" }
audit: { backends: "store,stream" }   # Redis 可用才含 stream

# ---- T0 新增：真实服务依赖（云端地址由用户填写）----
database:
  sql:
    driver: "postgres"
    source: "host=<PG_HOST> port=5432 user=<PG_USER> password=<PG_PASSWORD> dbname=<PG_DB> sslmode=disable"
    migrate: true
cache:
  redis:
    addr: "<REDIS_HOST>:6379"
    password: "<REDIS_PASSWORD>"   # 无密码留空
    db: 0
storage:
  minio:
    endpoint: "<MINIO_HOST>:9000"
    access_key: "<MINIO_ACCESS_KEY>"
    secret_key: "<MINIO_SECRET_KEY>"
    use_ssl: false
registry:
  type: "nacos"
  nacos:
    server_addrs: ["<NACOS_HOST>:8848"]
    # namespace 必须填 Nacos「命名空间 ID」（UUID）而非显示名——ID 不匹配时注册
    # 会被服务端拒绝/落孤儿空间（nacos-sdk-go v2 静默吞 403，仅 WARN）。
    namespace: "<NAMESPACE_ID>"
    group: "<GROUP>"               # 留空走 SDK 默认 DEFAULT_GROUP
    # 服务端开启鉴权时必填（gRPC 连接 setup 时登录；未开启可留空）。
    username: "<NACOS_USERNAME>"
    password: "<NACOS_PASSWORD>"

# ---- 配置中心（契约 config 段 → appkit 配置层）----
# 层优先级低于本地文件/env/flag：远程只补充本地未定义的键（本地值始终胜出）；
# dataId 内容变更经 nacos ListenConfig 推送热更新（Watch=true）。
config:
  nacos:
    server_addrs: ["<NACOS_ADDR>:8848"]
    namespace: "<NAMESPACE_ID>"
    group: "DEFAULT_GROUP"
    data_id: "go-bald-admin.yaml"
    format: "yaml"
    username: "<NACOS_USERNAME>"   # 服务端开启鉴权时必填
    password: "<NACOS_PASSWORD>"

# ---- T9 新增：可观测性（tracer/metrics 契约段）----
# tracer.otlp.endpoint 空则 trace 走核心 no-op（零配置可运行）。
tracer:
  type: "otlp"
  otlp:
    endpoint: "<OTLP_HOST>:4318"   # 裸地址默认 insecure；https:// 前缀走 TLS
    insecure: true
    # headers:                     # 远端 APM 鉴权（如 Grafana Cloud）
    #   Authorization: "Bearer <token>"
    sampler: "always_on"           # always_on / always_off / trace_id_ratio / parent_based
    sample_ratio: 1.0              # 仅 trace_id_ratio 生效
metrics:
  # prometheus 暴露端点总是挂载（供本地抓取），otlp 段非空则叠加直推。
  type: "otlp"
  prometheus: { addr: ":9091", path: "/metrics" }
  otlp:
    endpoint: "<OTLP_HOST>:4318"
    insecure: true
    push_interval: 15              # 秒

# ---- 业务自持段（storage.minio 契约无 bucket 字段，file 模块自持）----
file:
  bucket: "bald-admin"

# ---- Wave 1a：登录限流（业务自持段）----
# 框架契约的 server.http.rate_limit 是**中间件级**限流且当前零实现
#（无 Go 代码消费该段），故业务级登录限流走自持配置段。
# 未配置（或 rate/burst 非正）→ 禁用态：不阻断登录（fail-open，对齐源项目
# LoginRateLimiter 的语义——限流是防御性增强，不应因组件故障导致登录不可用）。
# 限流在凭据校验**之前**生效（先拦流量再做昂贵 bcrypt 比较）。
# 超限返回 HTTP 429 + reason="auth/rate_limited"。
login:
  rate_limit:
    rate: 1      # 每秒补充令牌数（rate=1 → 约每秒放行 1 次尝试）
    burst: 5     # 突发容量（首次可连续尝试次数）
  # Wave 1b：登录 DB 查询熔断（可选，整段缺省即禁用）。
  # 意义：DB 故障时快速失败（HTTP 503），避免所有登录请求都卡在超时上（雪崩）。
  # 用 hystrix（阈值式）：默认 Closed 全放行，达阈值才 Open；Open 后 sleep_window
  # 过则转半开放一个探针请求。**只对真故障计数**——用户不存在（NotFound）是正常
  # 业务结果，不计入失败（否则可用不存在的用户名熔断整个登录）。
  # breaker:
  #   error_threshold: 0.5        # 错误率阈值（0-1），default 0.5
  #   request_volume: 20          # 最小请求量（低于此不评估），default 20
  #   sleep_window_seconds: 5     # Open 后多久转半开（秒），default 5
  # Wave 1c：登录 DB 查询重试（可选，整段缺省即禁用 = 单次查询）。
  # 与熔断组合：retry 处理偶发抖动（重试可恢复），熔断处理持续故障（快速失败）。
  # 分类器固定为「只重试瞬时故障」——不重试 ErrNotFound（确定性业务结果，
  # 重试只是浪费 DB 往返并拖慢响应）。
  # retry:
  #   max_attempts: 3             # 最大尝试次数（含首次），default 3
  #   initial_backoff_ms: 200     # 首次退避（毫秒），default 200
  #   max_backoff_ms: 10000       # 退避上限（毫秒），default 10000

# ---- Wave 1d：认证令牌生命周期（业务自持段）----
# Logout 吊销名单与 RefreshToken 刷新令牌存储在 Redis（复用 cache.redis 连接）。
# **Redis 不可用时自动降级**（不是 fail-fast，因为核心登录仍可用）：
#   - Logout 记日志不吊销（JWT 无状态，无存储则无法收回）；
#   - Login 不签发 refresh_token（无处可查的刷新令牌没有意义）；
#   - ValidateToken 退化为纯验签（无吊销检查）。
# auth:
#   access_ttl_minutes: 120       # 访问令牌有效期（分钟），default 120（2h）
#   refresh_ttl_hours: 168        # 刷新令牌有效期（小时），default 168（7d）
