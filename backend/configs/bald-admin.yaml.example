# =============================================================================
# BALD-ADMIN 配置模板
# =============================================================================
#
# ⚠️ 顶层键名写错会被**静默丢弃**，不报错。
#
# 原因：契约解析用 DiscardUnknown（bconf/unmarshal.go），以便 proto 未声明的
# 业务段（本文件的 file / login / gateway）与框架段共存。代价是无法区分
# 「合法业务段」与「拼错的契约字段」——两者都被丢弃。
#
# 已有真实案例：本文件原先写作 `log: { level, format }`，而契约字段名是
# `logger`，且 level/format 属于 `logger.backends[].slog`。整段被丢弃，
# 日志实际一直用契约默认 `format=console`，配置看起来生效实则从未生效。
#
# 改动配置前，请对照契约顶层字段名（共 15 个，缺一即拼错）：
#   app  server  config  registry  logger  tracer  metrics  broker  storage
#   ai   workflow  cache  script  database  audit
# 以及本项目自有的业务段：
#   file  login  （以及 server 下的 gateway 子段）
#
# =============================================================================

# ---- 应用元数据（契约 app 段）----
# 这些值原写在代码里（cmd/bald-admin/app/assembly.go），现由本段驱动。
# 缺省时回退契约内置值（app.name="bald-app" / version="v0.0.0" /
# stop_timeout=30s），故**建议显式声明**以免服务身份与预期不符。
#
# 注意 app.name 是**服务身份**（日志 attrs / 注册中心实例名），
# 不决定 env 前缀——配置命名空间由代码层 appkit.WithConfigNamespace 声明。
app:
  name: "bald-admin"
  version: "v0.1.0"
  # 优雅停机超时：等待在途请求完成的上限。
  stop_timeout: "15s"

server:
  http:
    addr: ":8080"
    # ---- 中间件段（契约 server.http.middleware.*）----
    # 由 bundle.FromMiddleware 翻译为 gin 中间件链（见 cmd/bald-admin/app/assembly.go）。
    # 该段此前**零消费者**（配置写了不生效），现已在生产装配路径接通。
    #
    # 缺省语义（不写本段时的行为）：
    #   - recovery / request_id / logging：**本就默认开启**（bundle 链无条件挂载），
    #     本段仅用于覆盖其参数（stack_trace / header_name / skip_paths）；
    #   - cors / tracing / rate_limit / timeout：**段缺失即不挂**，需在此显式声明。
    middleware:
      request_id:
        header_name: "X-Request-ID"
      # 跨域。开发期允许任意来源；生产请改为前端实际来源列表。
      #
      # ⚠️ `allowed_origins: ["*"]` 与 `allow_credentials: true` **不可同时出现**
      # ——W3C Fetch 规范禁止带凭证的响应使用通配来源，浏览器会拒绝该响应；装配期
      # 对此 fail-fast（见 bald pkg/middleware/gin CORSConfig.Validate）。需携带
      # Cookie/凭证时，必须显式列出来源：
      #   allowed_origins: ["https://console.example.com"]
      #   allow_credentials: true
      cors:
        allowed_origins: ["*"]
        allowed_methods: ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
        allowed_headers: ["Content-Type", "Authorization", "X-Request-ID"]
        # 浏览器 JS 可读的额外响应头（CORS 安全列表之外的）。
        exposed_headers: ["X-Request-ID", "X-Total-Count"]
        allow_credentials: false
        max_age: 86400
      # 请求超时（可选，整段缺省即不启用）。超时以 status_code 结束响应（默认 503）。
      # ⚠️ 超时**不中断** handler（Go 无法杀死 goroutine），只保证响应及时返回；
      # 需真正终止时，handler 应自行监听 ctx.Done 做清理。
      # timeout:
      #   default_timeout_ms: 30000
      #   status_code: 503
      # 链路追踪（可选）。与 logging 的区别：只起 span/注入 trace_id，不写请求日志。
      # tracing: {}
  grpc:
    addr: ":9090"

  # ---- Wave 4：协议服务器的契约装配（asynq / cron / gateway）----
  #
  # 三者原本走 appkit.WithExtraServers / WithExtraServerFunc 逃生舱；
  # Wave 4 起由本仓注册的 provider 覆盖（见 cmd/bald-admin/app/registries.go
  # 的 serverRegistry），改由契约段驱动。
  #
  # gateway：grpc-gateway REST 转码面（独立端口）。backend_grpc_addr 留空时
  # 回退 server.grpc.addr。
  gateway:
    addr: ":8081"
    # backend_grpc_addr: ":9090"   # 留空即用 server.grpc.addr

  # asynq：任务队列（需 Redis）。redis_address 留空时回退
  #   env BALD_ADMIN_REDIS_ADDR > 契约段 cache.redis（保既有部署兼容）。
  # concurrency 缺省时用 asynq 实现默认（20）——此前硬编码为 4，故此处显式
  # 写 4 以保持行为等价（迁移不引入并发度变更）。
  asynq:
    concurrency: 4
    # codec: "json"                # 留空回退 env BALD_ADMIN_ASYNQ_CODEC
    # queues: ["critical", "default"]  # 按优先级从高到低
    # scheduler_enabled: true      # 未设置 → 实现默认

  # cron：进程内定时调度器（无外部依赖）。seconds 默认启用（6 字段表达式）。
  cron:
    # seconds: true                # 未设置 → 实现默认（启用）
    # location: "Asia/Shanghai"    # 留空用本地时区

# 日志（契约字段名是 `logger`，非 `log`）
#
# ⚠️ 本段原先写作 `log: { level, format }` —— **双重错误**：键名应为 `logger`，
# 且 level/format 属于 backends[].slog 而非顶层。该写法下整段被 DiscardUnknown
# 丢弃，日志实际一直用契约默认（format=console），配置看起来生效实则无声失效。
logger:
  # 全局脱敏 key 清单：命中 key 的属性值统一替换为 ***（属性保留不丢弃）。
  # 覆盖**位置参数对**（Info(ctx, "password", v)）与 **ctx 属性流**两类来源，
  # **全部后端统一生效**（含 loki/SLS 等远端可检索平台——合规宁全勿漏）。
  #
  # ⚠️ 与代码里的 bslog.WithFilter 是**互补**关系，不是重复：
  #   本段（契约层）不处理 slog.Attr 形式（slog.String("password", v)），
  #   那由 assembly.go 的 bslog.WithFilter(FilterKey(...)) 在 handler 层覆盖。
  #   两者缺一即有来源未被掩码，故并存。
  filter_keys: ["password", "token"]
  backends:
    - type: "slog"
      slog:
        level: "info"
        format: "json"
# audit.backends 逐项必须是**已注册**的 provider。当前注册了 `store` 与
# `stream`（见 cmd/bald-admin/app/audit_wiring.go）。`stream` 需 cache.redis
# 可达，否则启动 fail-fast（配置意图无法兑现，不静默降级）。
# 审计兜底租户（可选，缺省 t-default）：login 失败/permission 变更/data_access
# 三类事件天然无租户（用户不存在时无从得知其租户；权限变更与 SQL 采集路径
# 不带租户）。审计查询走租户隔离后，这些记录会因 tenant_id 为空而查不到——
# 而「谁在试密码 / 谁改了权限」正是审计最需要的线索。故落库时兜底到此值。
# 部署的默认租户若不叫 t-default，在此覆盖即可（无需改代码）。
# 注意：用户名/动作等线索记在独立字段，不受此兜底影响。
audit:
  # store=同步落库（查询面数据源）；stream=Redis Stream 异步（需 cache.redis 可达，
  # 否则启动 fail-fast）。可单选或并列。
  backends: ["store", "stream"]
  stream:
    stream: "audit.events"
    buffer: 1024
  fallback_tenant: "t-default"

# ---- T0 新增：真实服务依赖（云端地址由用户填写）----
database:
  sql:
    driver: "postgres"
    source: "host=<PG_HOST> port=5432 user=<PG_USER> password=<PG_PASSWORD> dbname=<PG_DB> sslmode=disable"
    migrate: true
cache:
  redis:
    addr: "<REDIS_HOST>:6379"
    password: "<REDIS_PASSWORD>"   # 无密码留空
    db: 0
storage:
  minio:
    endpoint: "<MINIO_HOST>:9000"
    access_key: "<MINIO_ACCESS_KEY>"
    secret_key: "<MINIO_SECRET_KEY>"
    use_ssl: false
registry:
  type: "nacos"
  nacos:
    server_addrs: ["<NACOS_HOST>:8848"]
    # namespace 必须填 Nacos「命名空间 ID」（UUID）而非显示名——ID 不匹配时注册
    # 会被服务端拒绝/落孤儿空间（nacos-sdk-go v2 静默吞 403，仅 WARN）。
    namespace: "<NAMESPACE_ID>"
    group: "<GROUP>"               # 留空走 SDK 默认 DEFAULT_GROUP
    # 服务端开启鉴权时必填（gRPC 连接 setup 时登录；未开启可留空）。
    username: "<NACOS_USERNAME>"
    password: "<NACOS_PASSWORD>"

# ---- 配置源契约段（**至少一个源可构造**，否则启动报
# "bootstrap: no config source configured"）----
# file 源指向本文件自身——它不依赖网络，是本地开发与 CI 的默认可用源。
# 仅配 nacos（下方）时，无网络环境会因「一个源都构造不出」而启动失败。
#
# 注：下方 nacos 段需网络；离线场景由 config.file 保证至少一个源可用。
config:
  file:
    path: "configs/bald-admin.yaml"
    format: "yaml"
    watch: false
  # 配置中心（层优先级低于本地文件/env/flag：远程只补充本地未定义的键，
  # 本地值始终胜出；dataId 内容变更经 nacos ListenConfig 推送热更新）。
  nacos:
    server_addrs: ["<NACOS_ADDR>:8848"]
    namespace: "<NAMESPACE_ID>"
    group: "DEFAULT_GROUP"
    data_id: "bald-admin.yaml"
    format: "yaml"
    username: "<NACOS_USERNAME>"   # 服务端开启鉴权时必填
    password: "<NACOS_PASSWORD>"

# ---- T9 新增：可观测性（tracer/metrics 契约段）----
# tracer.otlp.endpoint 空则 trace 走核心 no-op（零配置可运行）。
tracer:
  type: "otlp"
  otlp:
    endpoint: "<OTLP_HOST>:4318"   # 裸地址默认 insecure；https:// 前缀走 TLS
    insecure: true
    # headers:                     # 远端 APM 鉴权（如 Grafana Cloud）
    #   Authorization: "Bearer <token>"
    sampler: "always_on"           # always_on / always_off / trace_id_ratio / parent_based
    sample_ratio: 1.0              # 仅 trace_id_ratio 生效
metrics:
  # prometheus 暴露端点总是挂载（供本地抓取），otlp 段非空则叠加直推。
  type: "otlp"
  prometheus: { addr: ":9091", path: "/metrics" }
  otlp:
    endpoint: "<OTLP_HOST>:4318"
    insecure: true
    push_interval: 15              # 秒

# ---- 业务自持段（storage.minio 契约无 bucket 字段，file 模块自持）----
file:
  bucket: "bald-admin"

# ---- Wave 1a：登录限流（业务自持段）----
# 与框架契约的 server.http.middleware.rate_limit 是**两个层次**：
#   - 契约段（server.http.middleware.rate_limit）是**中间件级**限流，现已实现并
#     接通（按 IP/全局维度拦流量，见上）；
#   - 本段是**业务级**限流，作用于「登录尝试」这一具体业务动作（可按用户名等
#     业务维度计数），故仍由业务自持配置。
# 未配置（或 rate/burst 非正）→ 禁用态：不阻断登录（fail-open，对齐源项目
# LoginRateLimiter 的语义——限流是防御性增强，不应因组件故障导致登录不可用）。
# 限流在凭据校验**之前**生效（先拦流量再做昂贵 bcrypt 比较）。
# 超限返回 HTTP 429 + reason="auth/rate_limited"。
login:
  rate_limit:
    rate: 1      # 每秒补充令牌数（rate=1 → 约每秒放行 1 次尝试）
    burst: 5     # 突发容量（首次可连续尝试次数）
  # Wave 1b：登录 DB 查询熔断（可选，整段缺省即禁用）。
  # 意义：DB 故障时快速失败（HTTP 503），避免所有登录请求都卡在超时上（雪崩）。
  # 用 hystrix（阈值式）：默认 Closed 全放行，达阈值才 Open；Open 后 sleep_window
  # 过则转半开放一个探针请求。**只对真故障计数**——用户不存在（NotFound）是正常
  # 业务结果，不计入失败（否则可用不存在的用户名熔断整个登录）。
  # breaker:
  #   error_threshold: 0.5        # 错误率阈值（0-1），default 0.5
  #   request_volume: 20          # 最小请求量（低于此不评估），default 20
  #   sleep_window_seconds: 5     # Open 后多久转半开（秒），default 5
  # Wave 1c：登录 DB 查询重试（可选，整段缺省即禁用 = 单次查询）。
  # 与熔断组合：retry 处理偶发抖动（重试可恢复），熔断处理持续故障（快速失败）。
  # 分类器固定为「只重试瞬时故障」——不重试 ErrNotFound（确定性业务结果，
  # 重试只是浪费 DB 往返并拖慢响应）。
  # retry:
  #   max_attempts: 3             # 最大尝试次数（含首次），default 3
  #   initial_backoff_ms: 200     # 首次退避（毫秒），default 200
  #   max_backoff_ms: 10000       # 退避上限（毫秒），default 10000

# ---- Wave 1d：认证令牌生命周期（业务自持段）----
# Logout 吊销名单与 RefreshToken 刷新令牌存储在 Redis（复用 cache.redis 连接）。
# **Redis 不可用时自动降级**（不是 fail-fast，因为核心登录仍可用）：
#   - Logout 记日志不吊销（JWT 无状态，无存储则无法收回）；
#   - Login 不签发 refresh_token（无处可查的刷新令牌没有意义）；
#   - ValidateToken 退化为纯验签（无吊销检查）。
# auth:
#   access_ttl_minutes: 120       # 访问令牌有效期（分钟），default 120（2h）
#   refresh_ttl_hours: 168        # 刷新令牌有效期（小时），default 168（7d）
